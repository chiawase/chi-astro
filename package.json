{
  "name": "chi-astro",
  "type": "module",
  "scripts": {
    "dev": "FETCH_WEBMENTIONS=true astro dev",
    "dev:host": "FETCH_WEBMENTIONS=true astro dev --host",
    "prebuild": "rm -rf _cache",
    "build": "FETCH_WEBMENTIONS=true astro build",
    "postbuild": "npm run webmentions:send",
    "webmentions:fetch": "webmention https://chisenires.design/feed.xml",
    "webmentions:send": "webmention https://chisenires.design/feed.xml --limit 1 --send",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/markdown-remark": "^6.3.10",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/node": "^9.5.1",
    "@astrojs/rss": "^4.0.14",
    "@astrojs/sitemap": "^3.6.0",
    "@braindb/astro": "^0.1.1",
    "@braindb/remark-wiki-link": "^2.1.0",
    "@flowershow/remark-wiki-link": "^3.3.1",
    "@fontsource-variable/anybody": "^5.2.7",
    "@fontsource-variable/victor-mono": "^5.2.8",
    "@remy/webmention": "^1.5.0",
    "astro": "^5.16.5",
    "astro-cloudinary": "^1.3.5",
    "astro-embed": "^0.9.2",
    "dotenv": "^17.2.3",
    "lodash": "^4.17.21",
    "luxon": "^3.7.2",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-to-string": "^4.0.0",
    "reading-time": "^1.5.0",
    "rehype-accessible-emojis": "^0.3.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-figure-title": "^1.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-remove-comments": "^6.1.1",
    "rehype-stringify": "^10.0.1",
    "remark-code-title": "^0.2.5",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-remove-comments": "^1.1.1",
    "remark-toc": "^9.0.0",
    "sharp": "^0.34.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.21",
    "@types/luxon": "^3.7.1",
    "@types/node-fetch": "^2.6.13",
    "typescript": "^5.9.3"
  }
}
