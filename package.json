{
  "name": "chi-astro",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "prebuild": "rm -f _cache/webmentions.json",
    "build": "FETCH_WEBMENTIONS=true astro build",
    "build:local": "astro build",
    "postbuild": "npm run webmentions:send",
    "preview": "astro preview",
    "astro": "astro",
    "webmentions:fetch": "webmention https://chisenires.design/feed.xml",
    "webmentions:send": "webmention https://chisenires.design/feed.xml --limit 1 --send",
    "mux:upload": "tsx src/scripts/muxUploadAll.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/markdown-remark": "^6.3.10",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/node": "^9.5.1",
    "@astrojs/rss": "^4.0.14",
    "@astrojs/sitemap": "^3.6.0",
    "@braindb/astro": "^0.1.1",
    "@braindb/remark-wiki-link": "^2.1.0",
    "@flowershow/remark-wiki-link": "^3.3.1",
    "@fontsource-variable/anybody": "^5.2.7",
    "@fontsource-variable/victor-mono": "^5.2.8",
    "@iconify-json/simple-icons": "^1.2.65",
    "@mux/mux-node": "^12.8.1",
    "@mux/mux-player-astro": "^3.10.2",
    "@remy/webmention": "^1.5.0",
    "astro": "^5.16.5",
    "astro-cloudinary": "^1.3.5",
    "astro-embed": "^0.11.0",
    "astro-icon": "^1.1.5",
    "chokidar": "^5.0.0",
    "cloudinary": "^2.8.0",
    "lodash": "^4.17.21",
    "luxon": "^3.7.2",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-to-string": "^4.0.0",
    "reading-time": "^1.5.0",
    "rehype-accessible-emojis": "^0.3.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-figure-title": "^1.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-remove-comments": "^6.1.1",
    "rehype-stringify": "^10.0.1",
    "remark-code-title": "^0.2.5",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-remove-comments": "^1.1.1",
    "remark-toc": "^9.0.0",
    "sharp": "^0.34.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.6",
    "@types/lodash": "^4.17.21",
    "@types/luxon": "^3.7.1",
    "astro-robots-txt": "^1.0.0",
    "dotenv": "^17.2.3",
    "sharp-cli": "^5.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "minimist": "0.2.4",
    "nth-check": "2.1.1",
    "glob": "11.1.0"
  }
