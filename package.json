{
  "name": "chi-astro",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "build": "FETCH_WEBMENTIONS=true astro build",
    "build:local": "astro build",
    "postbuild": "if [ \"$SEND_WEBMENTIONS\" = \"true\" ]; then npm run webmentions:send; else echo \"Skipping webmentions:send\"; fi",
    "preview": "astro preview",
    "astro": "astro",
    "cloudinary:upload:folder": "tsx src/scripts/cloudinaryUploadFolder.ts",
    "webmentions:clean": "rm -f _cache/webmentions.json",
    "webmentions:fetch": "webmention https://chisenires.design/feed.xml",
    "webmentions:send": "webmention https://chisenires.design/feed.xml --limit 1 --send",
    "mux:upload": "tsx src/scripts/muxUploadAll.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{md,mdx}": [
      "node src/scripts/smartquotes-staged.mjs"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/markdown-remark": "^6.3.10",
    "@astrojs/mdx": "^4.3.13",
    "@astrojs/node": "^9.5.1",
    "@astrojs/rss": "^4.0.14",
    "@astrojs/sitemap": "^3.7.0",
    "@braindb/astro": "^0.1.1",
    "@braindb/remark-wiki-link": "^2.1.0",
    "@flowershow/remark-wiki-link": "^3.3.1",
    "@fontsource-variable/anybody": "^5.2.7",
    "@fontsource-variable/source-sans-3": "^5.2.9",
    "@fontsource-variable/victor-mono": "^5.2.8",
    "@iconify-json/simple-icons": "^1.2.65",
    "@mux/mux-node": "^12.8.1",
    "@mux/mux-player-astro": "^3.10.2",
    "@remy/webmention": "^1.5.0",
    "astro": "^5.18.1",
    "astro-cloudinary": "^1.3.5",
    "astro-embed": "^0.12.0",
    "astro-icon": "^1.1.5",
    "astro-lightgallery": "^2.3.0",
    "chokidar": "^5.0.0",
    "cloudinary": "^2.9.0",
    "defu": "^6.1.6",
    "devalue": "^5.6.4",
    "diff": "^8.0.3",
    "h3": "^2.0.1-rc.19",
    "lodash": "^4.17.23",
    "luxon": "^3.7.2",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-to-string": "^4.0.0",
    "picomatch": "^4.0.4",
    "reading-time": "^1.5.0",
    "rehype-accessible-emojis": "^0.3.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-figure-title": "^1.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-remove-comments": "^6.1.1",
    "rehype-stringify": "^10.0.1",
    "remark-code-title": "^0.2.5",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "remark-remove-comments": "^1.1.1",
    "sharp": "^0.34.3",
    "smol-toml": "^1.6.1",
    "tar": "^7.5.11",
    "undici": "^7.24.1",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "^1.10.6",
    "@types/lodash": "^4.17.21",
    "@types/luxon": "^3.7.1",
    "astro-robots-txt": "^1.0.0",
    "dotenv": "^17.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-smartypants": "^3.0.2",
    "remark-stringify": "^11.0.0",
    "sharp-cli": "^5.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5"
  },
  "overrides": {
    "minimist": "0.2.4",
    "nth-check": "2.1.1",
    "glob": "11.1.0"
  }
}
