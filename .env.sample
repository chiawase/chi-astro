# Webmentions
WEBMENTION_IO_TOKEN=

# Cloudinary (public — exposed to client)
PUBLIC_CLOUDINARY_CLOUD_NAME=
PUBLIC_CLOUDINARY_API_KEY=

# Cloudinary (server-only)
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# Mux (server-only)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Cross-posting (npm run crosspost; in CI these are GitHub Actions secrets/variables)
# Mastodon: Preferences → Development → New application, scope write:statuses
MASTODON_INSTANCE=https://social.lol
MASTODON_ACCESS_TOKEN=
# Bluesky: Settings → Privacy and security → App passwords
BLUESKY_IDENTIFIER=chisenires.design
BLUESKY_APP_PASSWORD=
# Threads: long-lived user token with threads_basic + threads_content_publish
THREADS_ACCESS_TOKEN=
