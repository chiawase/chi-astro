---
import { Image } from "astro:assets";
import { type CollectionEntry, getCollection, render } from "astro:content";
import BaseHead from "@components/BaseHead.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import PostMetadata from "@components/PostMetadata.astro";
import Webmentions from "@components/WebmentionsLoader.astro";
import { createExcerpt } from "@utils/create-excerpt";
import { SITE_URL, SITE_AUTHOR, SITE_TITLE } from "@consts";

type Props = {
  post: CollectionEntry<"blog">;
  slug: string;
  postReadingTime?: string;
};

const {
  post,
  slug,
  postReadingTime
} = Astro.props;

// Build the same sorted list here to find neighbors
const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (b, a) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const index = allPosts.findIndex((p) => p.id === post.id);

// If sorted newest-first:
// "next" is older (index+1), "prev" is newer (index-1)
const prevPost = index > 0 ? allPosts[index - 1] : null;
const nextPost =
  index >= 0 && index < allPosts.length - 1 ? allPosts[index + 1] : null;

// Making appropriate metadata in case of missing title or description
const websiteTitle = post.data.title ??
(createExcerpt(post.body ?? "").substring(0, 60)+"... • "+ SITE_TITLE);

const websiteDescription = post.data.description ??
createExcerpt(post.body?? "").substring(0, 180)+"...";
---

<html lang="en">
  <head>
    <BaseHead
      post={post}
      title={websiteTitle}
      description={websiteDescription}
    />

  </head>

  <body>
    <Header />
    <main>
      <article class="h-entry">
        {
          post.data.title && (
            <h1 class="p-name">{post.data.title}</h1>

            <PostMetadata
              post={post}
              postTags={post.data.tags}
              postSlug={slug}
              postDate={post.data.pubDate}
              postUpdatedDate={post.data.updatedDate}
              postLanguage?={post.data.postLanguage}
              postReadingTime={postReadingTime}
            />
          )
        }

        <div class="u-author h-card">
          <data value={SITE_URL} class="u-url"></data>
          <data value="chiawase" class="p-nickname"></data>
          <data value=`${SITE_URL}/img/chi.jpg` class="u-photo"></data>
          <data value={SITE_AUTHOR.email} class="u-email"></data>
          <data
            value="UX Designer, Gamer, Bike commuter from the Philippines"
            class="p-note"></data>
        </div>

        <div class="e-content">
          <slot />
        </div>

        <PostMetadata
          post={post}
          postTags={post.data.tags}
          postSlug={slug}
          postDate={post.data.pubDate}
          postUpdatedDate={post.data.updatedDate}
          postLanguage?={post.data.postLanguage}
          postReadingTime={postReadingTime}
        />
      </article>

      <!-- Previous and Next blog posts -->
      <ul class="links-nextprev">
        {
          prevPost && (
            <li class="links-nextprev-prev">
              <a href={`/blog/${prevPost.id}/`}>← Previous</a>
              <span class="post-title-prev">{prevPost.data.title}</span>
            </li>
          )
        }
        {
          nextPost && (
            <li class="links-nextprev-next">
              <a href={`/blog/${nextPost.id}/`}>Next →</a>
              <span class="post-title-next">{nextPost.data.title}</span>
            </li>
          )
        }
      </ul>

      <Webmentions />
    </main>
    <Footer />
  </body>
</html>
<style>
  .links-nextprev {
    display: flex;
    justify-content: space-between;
    gap: 0.5em 1em;
    list-style: "";
    border-top: 1px dashed var(--color-gray-20);
    padding: 1em 0;
  }
  .links-nextprev > * {
    flex: 1;
  }
  [class*="post-title-"] {
    display: block;
  }
  .links-nextprev-next {
    text-align: right;
  }

  .post-backlinks {
    margin-bottom: 2rem;
  }

  /* Images in posts, and also in other pages */
  article picture img,
  .page picture img {
	border-radius: 1rem;
	max-width: 100%;
	height: auto;
	display: block;
	margin: 0 auto;
  }
</style>
