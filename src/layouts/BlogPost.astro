---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import PostMetadata from "../components/PostMetadata.astro";
import { SITE_URL, SITE_AUTHOR } from "../consts";

type Props = CollectionEntry<"blog">["data"] & { slug: string };

const { title, description, pubDate, updatedDate, heroImage, draft, tags, slug, postLanguage } = Astro.props;

---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />

  </head>

  <body>
    <Header />
    <main>
      <article class="h-entry">
        {
          title && (
            <h1 class="p-name">{title}</h1>
            <!-- add handling for drafts here -->

            <PostMetadata postTags={tags} postSlug={slug} postDate={pubDate} postUpdatedDate={updatedDate} draft={draft} postLanguage={postLanguage} />
          )
        }


        <div class="u-author h-card">
          <data value={SITE_URL} class="u-url"></data>
          <data value="chiawase" class="p-nickname"></data>
          <data value=`${SITE_URL}/img/chi.jpg` class="u-photo"></data>
          <data value={SITE_AUTHOR.email} class="u-email"></data>
          <data
            value="UX Designer, Gamer, Bike commuter from the Philippines"
            class="p-note"></data>
        </div>

        <div class="e-content">
          <slot />
        </div>

        <PostMetadata tags={tags} slug={slug} date={pubDate} />
      </article>
    </main>
    <Footer />
  </body>
</html>
