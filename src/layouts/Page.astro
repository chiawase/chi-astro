---
import { SITE_TITLE } from "@consts";
import type { CollectionEntry } from "astro:content";

import BaseHead from "@components/BaseHead.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";

interface Props {
  post?: CollectionEntry<"blog"> | CollectionEntry<"archive">;
  title?: string | null;
  description?: string | null;
  showTitle?: boolean;
}

const {
  post,
  title,
  description,
  showTitle = true
} = Astro.props;

// Add handling in case of 404
const headTitle =
  title === "404" ? `Not found • ${SITE_TITLE}` : title;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
    post={post}
      title={headTitle ?? undefined}
      description={description ?? undefined}
    />
  </head>

  <body>
    <a id="skip-link" class="visually-hidden" href="#main">Skip to content</a>

    <Header />

    <main id="main">
      {showTitle && title && title !== "404" && <h1>{title}</h1>}
      <slot />
    </main>

    <Footer />
  </body>
</html>
