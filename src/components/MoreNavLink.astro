---
import type { MorePagesEntry } from "@data/morePages";

const { entry } = Astro.props as { entry: MorePagesEntry };
---

<li>
  {entry.children?.length ? (
  <>
    <a href={entry.url}>{entry.title}</a>
    <ul role="list">
      {entry.children.map((child) => (
        <Astro.self entry={child} />
      ))}
    </ul>
  </>
  ) : (
    <a href={entry.url}>{entry.title}</a>
  )}
</li>
