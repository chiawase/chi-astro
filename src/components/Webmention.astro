---
import { Image } from "astro:assets";
import FormattedDate from "@components/FormattedDate.astro";

import { prepareOgText } from "@utils/prepareOgText";

// derived from:
// - https://github.com/siakaramalegos/sia.codes-eleventy/blob/main/src/_includes/webmention.njk
// - https://github.com/maxboeck/eleventy-webmentions/blob/master/_includes/webmention.njk
// - https://www.stevefrenzel.dev/posts/webmentions-in-astro-for-blog-posts/

interface AuthorProps {
  name: string;
  photo: string;
  url: string;
}

interface WebmentionContentProps {
  html?: string;
  text?: string;
}

interface WebmentionProps {
  author: AuthorProps;
  url?: string;
  published?: string;
  "wm-received": string;
  "wm-id": number;
  "wm-source": string;
  "wm-target": string;
  "wm-protocol": string;
  name?: string;
  syndication: string[];
  content: WebmentionContentProps;
  "wm-property": string;
}

interface Props {
  webmention: WebmentionProps;
}

const { webmention } = Astro.props;

// Webmention specific props
const authorName = webmention.author?.name ?? "Anonymous";
const authorUrl = webmention.author?.url;
const authorPhoto = webmention.author?.photo;

const sourceUrl = webmention.url ?? webmention["wm-source"];
const text = webmention.content?.text;
---

<article class="webmention h-cite" id={`webmention-${webmention["wm-id"]}`}>
  <div class="webmention__meta">
    <span class="p-author h-card webmention__author">
      {
        authorPhoto ? (
          <Image alt="" height={48} width={48} loading="lazy" class="u-photo webmention__author__photo" src={authorPhoto} />
        ) : (
          <Image alt="" height={48} width={48} loading="lazy" class="u-photo webmention__author__photo" src="/webmention-avatar-default.svg" />
        )
      }

      {
        authorUrl ? (
          <a href={authorUrl} rel="author noopener noreferrer" target="_blank" class="p-name"><strong>{authorName}</strong></a>
        ) : (
          <span class="p-name">
            <strong>{authorName}</strong>
          </span>
        )
      }
    </span>

    {
      webmention.published && (
        <FormattedDate dateType="webmention" dateString={webmention.published} />
      )
    }
  </div>

  {
    text ? (
      <p class="webmention__content p-content">
        {prepareOgText(text, { maxLength: 280 })}&nbsp;
        {sourceUrl && (
          <a href={sourceUrl} class="u-url" rel="noopener noreferrer" target="_blank">source</a>
        )}
      </p>
    ) : (
      sourceUrl && (
        <p class="webmention__content">
          <a href={sourceUrl} class="u-url" rel="noopener noreferrer" target="_blank">source</a>
        </p>
      )
    )
  }
</article>
<style>
/* Single Webmention */

.webmention {
  display: block;
  border-left: 2px solid var(--text-color-link);
  margin-left: 0;
  padding: 1em;
  width: 100%;
  color: var(--text-color);
  background: var(--background-color-overlay);
  transition: var(--subtle-transition);
}

.webmention__meta,
.webmention__author {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.webmention__meta {
  font-size: 0.8rem;
}

.webmention__author {
  margin-right: 0.25rem;
}
.webmention__author__photo {
  height: 2rem;
  width: 2rem;
  border-radius: 50%;
  object-fit: cover;
}

.webmention__author a.p-name {
  margin-left: 0.75rem;
}

:global(.webmention__pubdate) {
  margin-left: 0.25rem;
}
:global(.webmention__pubdate:before) {
  content: "\2022";
  margin-right: 0.5em;
}

.webmention__content {
  margin-top: 0.25rem;
}

.webmention__link_only {
  margin-left: 0.25rem;
}
</style>
