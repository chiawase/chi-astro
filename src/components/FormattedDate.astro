---
import { DateTime } from "luxon";

interface Props {
  dateString: Date | string;
  dateType: string;
}

const { dateString, dateType } = Astro.props;
const date = new Date(dateString);

// Match your Eleventy "readableDate" (ff ZZZZ) and zone "UTC+8"
const readableDate = DateTime.fromJSDate(date, { zone: "UTC+8" }).toFormat(
  "ff ZZZZ",
);

// Match your Eleventy "htmlDateString" (yyyy-LL-dd'T'HH:mm:ss)
const htmlDateString = DateTime.fromJSDate(date, { zone: "UTC+8" }).toFormat(
  "yyyy-LL-dd'T'HH:mm:ss",
);
---

<time
  class:list={[
    {
      "dt-published": dateType === "published",
      "dt-updated": dateType === "updated",
      "postlist-date dt-published webmention__pubdate":
        dateType === "webmention",
    },
  ]}
  datetime={htmlDateString}>{readableDate}</time
>
