---
const today = new Date();
import NavLink from "@components/NavLink.astro";
import { SITE_URL } from "@consts";
---

<a href="#main" class="back-to-top">Back to top &#8593;</a>

<footer>
  <p>All Rights Reserved &copy; {today.getFullYear()}</p>
  <p>Built with <a target="_blank" rel="noopener noreferrer" href="https://astro.build/">{Astro.generator}</a></p>
  <p><a title="Website Issues tab" href="https://github.com/chiawase/chi-astro/issues" target="_blank" rel="noopener noreferrer">View my website’s open issues</a></p>

  <h2 class="visually-hidden">Bottom level navigation menu</h2>
  <ul class="nav nav-footer">
    <NavLink href="/">Home</NavLink>
    <NavLink href="/blog/">Blog</NavLink>
    <NavLink href="/about/">About</NavLink>
    <NavLink href="/contact/">Contact</NavLink>
    <NavLink href="/now/">Now</NavLink>
    <NavLink href="/more/">More</NavLink>
    <!-- RSS Feed managed via Subscribe Openly -->
    <NavLink
      href=`https://subscribeopenly.net/subscribe/?url=${SITE_URL}/feed.xml`
      >Subscribe</NavLink
    >
    <NavLink href="/feed.xml">RSS Feed</NavLink>
  </ul>

  <!-- Webring links -->
  <h4>Webring links</h4>
  <a href="https://xn--sr8hvo.ws/previous">←</a>
  An <a href="https://xn--sr8hvo.ws">IndieWeb Webring</a> 🕸💍
  <a href="https://xn--sr8hvo.ws/next">→</a>
</footer>
<style>
.nav {
  font-family: var(--font-family-monospace);
}
.back-to-top {
  display: block;
  margin: 0 auto;
  width: fit-content;
}
</style>
