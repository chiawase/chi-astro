---
import { getMuxPlaybackId } from "@utils/muxUploader"; // adjust relative path

const { id, src, metadata } = Astro.props;

let playbackId = id;

if (!playbackId && src) {
  playbackId = await getMuxPlaybackId(src);
  if (!playbackId) {
    throw new Error(`No Mux playbackId found for src="${src}". Run "npm run mux:upload".`);
  }
}

// Map Mux video metadata to web component
const metadataAttr = metadata?.video_title
  ? { "metadata-video-title": metadata.video_title }
  : {};
---

<mux-player playback-id={playbackId} {... metadataAttr}></mux-player>
<script>import "@mux/mux-player";</script>
