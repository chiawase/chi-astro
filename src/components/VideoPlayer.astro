---
import { getMuxPlaybackId } from "@utils/muxUploader";

const { id, src, metadata } = Astro.props;

let playbackId = id;

if (!playbackId && src) {
  playbackId = await getMuxPlaybackId(src);
  if (!playbackId) {
    const msg = `No Mux playbackId found for src="${src}". Run: npm run mux:upload -- "${src}"`;
    // Builds still fail, so a missing video can't be deployed by accident
    if (!import.meta.env.DEV) throw new Error(msg);
    console.warn(`[mux] ${msg}`);
  }
}

// Map Mux video metadata to web component
const metadataAttr = metadata?.video_title
  ? { "metadata-video-title": metadata.video_title }
  : {};
---

{
  playbackId ? (
    <mux-player playback-id={playbackId} {...metadataAttr} />
  ) : (
    <p class="video-placeholder">
      Video not on Mux yet: <code>{src}</code>
    </p>
  )
}
<script>
  import "@mux/mux-player";
</script>

<style>
  .video-placeholder {
    padding: 2rem 1rem;
    border: 2px dashed currentColor;
    text-align: center;
    opacity: 0.7;
  }
</style>
