---
import Webmention from "@components/Webmention.astro";
import WebmentionsSummary from "@components/WebmentionsSummary.astro";
import WebmentionAvatars from "@components/WebmentionAvatars.astro";
import { SITE_URL } from "@consts";

// based on:
// - https://www.stevefrenzel.dev/posts/webmentions-in-astro-for-blog-posts/
// - https://kld.dev/adding-webmentions/
// - https://github.com/siakaramalegos/sia.codes-eleventy/blob/main/src/_includes/webmentions.njk
// - https://github.com/maxboeck/eleventy-webmentions/blob/master/_includes/webmentionlist.njk

interface Props {
  mentions: any[];
  likesSize: number;
  repostsSize: number;
  repliesSize: number;
  mentionOfSize: number;
}

const { mentions, likesSize, repostsSize, repliesSize, mentionOfSize } =
  Astro.props;

const authors = mentions
  .filter((m) => m["wm-property"] === "like-of" || m["wm-property"] === "repost-of")
  .map((m) => m.author)
  .filter(Boolean);

// Get all the authors who liked the post
const likesAuthors = mentions
  .filter((m) => m["wm-property"] === "like-of")
  .map((m) => m.author)
  .filter(Boolean);

// Get all the authors who reposted the post somewhere
const repostsAuthors = mentions
  .filter((m) => m["wm-property"] === "repost-of")
  .map((m) => m.author)
  .filter(Boolean);
---

<section class="webmentions">
  <h4 id="webmentions">Webmentions<a aria-hidden="true" tabindex="-1" href="#webmentions"><span class="icon icon-link"></span></a></h4>
  {mentions.length > 0 && (
  <div class="webmentions__summary_group">
    {/* This is a more elaborate version of webmentions summary, showing also author avatars beside the counters */}
    <div class="webmentions__summary">
      {likesSize > 0 && <span>💖 {likesSize} <WebmentionAvatars authors={likesAuthors} /></span>}
      {repostsSize > 0 && <span>🔁 {repostsSize} <WebmentionAvatars authors={repostsAuthors} /></span>}
      {repliesSize > 0 && <span>💬 {repliesSize}</span>}
      {mentionOfSize > 0 && <span>🗣️ {mentionOfSize}</span>}
    </div>

  </div>)}
  {mentions.length ? (
    <ol class="webmentions__list">
      {[...mentions].reverse().map((webmention) =>
        webmention?.content?.text != null ? (
          <li class="webmentions__item">
            <Webmention webmention={webmention} />
          </li>
        ) : null,
      )}
    </ol>
  ) : (
    <p>No mentions yet.</p>
  )}
  <p>
    These are <a href="https://indieweb.org/Webmention">webmentions</a> via the <a
      href="https://indieweb.org/">IndieWeb</a
    > and <a href="https://webmention.io/">webmention.io</a>. Mention this post
    from your site:
  </p>

  <form
    action=`https://webmention.io/${SITE_URL}/webmention`
    method="post"
    class="form-webmention"
  >
    <label for="form-webmention-source">URL</label>
    <input
      id="form-webmention-source"
      type="url"
      name="source"
      placeholder="https://example.com"
      required
    />
    <input
      type="hidden"
      name="target"
      value={new URL(Astro.url.pathname, `https://${SITE_URL}`).href}
    />
    <input type="submit" class="button button-small" value="Send Webmention" />
  </form>

  <p>
    You can also <a href="/contact/" title="These are my social links!"
      >reach out to me online</a
    > if you have thoughts to share about anything I’ve posted. Mostly I’m on <a
      href="https://threads.com/@_chiawase">Threads</a
    >, <a href="https://social.lol/@chi">Mastodon</a>, or <a
      href="https://bsky.app/profile/chisenires.design">Bluesky</a
    >.
  </p>
</section>
<style>
  /* Styling for Webmentions */
  /* Copied from https://github.com/maxboeck/eleventy-webmentions/blob/master/css/webmentions.css */

  .webmentions {
    display: block;
    text-align: left;
  }

  .webmentions__summary_group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }

  .webmentions__summary {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    padding-bottom: 1rem;
  }

  .webmentions__summary span {
    display: inline-flex;
    align-items: center;
  }

  .webmentions__list {
    list-style-type: none;
    padding: 0;
  }
  .webmentions__item {
    margin-bottom: 2rem;
  }
</style>
