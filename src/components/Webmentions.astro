---
import Webmention from "@components/Webmention.astro";
import { SITE_URL } from "@consts";

// based on:
// - https://www.stevefrenzel.dev/posts/webmentions-in-astro-for-blog-posts/
// - https://kld.dev/adding-webmentions/
// - https://github.com/siakaramalegos/sia.codes-eleventy/blob/main/src/_includes/webmentions.njk
// - https://github.com/maxboeck/eleventy-webmentions/blob/master/_includes/webmentionlist.njk

interface Props {
  mentions: any[];
  likesSize: number;
  repostsSize: number;
  repliesSize: number;
  mentionOfSize: number;
}

const { mentions, likesSize, repostsSize, repliesSize, mentionOfSize } =
  Astro.props;
---

<section class="webmentions">
  <h4>Webmentions</h4>

  {
    mentions.length > 0 && (
      <div class="webmentions__summary">
        {likesSize > 0 && <span>💖 {likesSize}</span>}
        {repostsSize > 0 && <span>🔁 {repostsSize}</span>}
        {repliesSize > 0 && <span>💬 {repliesSize}</span>}
        {mentionOfSize > 0 && <span>🗣️ {mentionOfSize}</span>}
      </div>
    )
  }

  {
    mentions.length ? (
      <ol class="webmentions__list">
        {[...mentions].reverse().map((webmention) =>
          webmention?.content?.text != null ? (
            <li class="webmentions__item">
              <Webmention webmention={webmention} />
            </li>
          ) : null,
        )}
      </ol>
    ) : (
      <p>No mentions yet.</p>
    )
  }

  <br />

  <p>
    These are <a href="https://indieweb.org/Webmention">webmentions</a> via the <a
      href="https://indieweb.org/">IndieWeb</a
    > and <a href="https://webmention.io/">webmention.io</a>. Mention this post
    from your site:
  </p>

  <form
    action=`https://webmention.io/${SITE_URL}/webmention`
    method="post"
    class="form-webmention"
  >
    <label for="form-webmention-source">URL</label>
    <input
      id="form-webmention-source"
      type="url"
      name="source"
      placeholder="https://example.com"
      required
    />
    <input
      type="hidden"
      name="target"
      value={new URL(Astro.url.pathname, `https://${SITE_URL}`).href}
    />
    <input type="submit" class="button button-small" value="Send Webmention" />
  </form>

  <p>
    You can also <a href="/contact" title="These are my social links!"
      >reach out to me online</a
    > if you have thoughts to share about anything I’ve posted. Mostly I’m on <a
      href="https://threads.com/@_chiawase">Threads</a
    >, <a href="https://social.lol/@chi">Mastodon</a>, or <a
      href="https://bsky.app/profile/chisenires.design">Bluesky</a
    >.
  </p>
</section>
<style>
  /* Styling for Webmentions */
  /* Copied from https://github.com/maxboeck/eleventy-webmentions/blob/master/css/webmentions.css */

  .webmentions {
    display: block;
    text-align: left;
  }

  .webmentions__summary {
    display: inline-flex;
    gap: 1rem;
    padding-bottom: 1rem;
  }

  .webmentions__facepile {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }
  .webmentions__face {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    object-fit: cover;
    flex: none;
  }
  .webmentions__list {
    list-style-type: none;
    padding: 0;
  }
  .webmentions__item {
    margin-bottom: 2rem;
  }
</style>
