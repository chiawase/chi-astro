---
import type { CollectionEntry } from "astro:content";
import ArchivePostListMetadata from "@components/ArchivePostListMetadata.astro";
import { prepareOgText } from "@utils/prepareOgText";

import { getReadingTime } from "@utils/readingTime";

interface Props {
  post: CollectionEntry<"archive">;
}

const { post } = Astro.props;

// Calculate reading time using `body` property
const postReadingTime = getReadingTime(post.body ?? "");
---

<li class="postlist-item">
  {/* if with title */}
  {post.data.title && (
      <a href={post.data.source
          ? `/archive/${post.data.source}/${post.id}/`
          : `/archive/${post.id}/`}
        class="postlist-link postlist-header">
          {post.data.title}
      </a>
    )}

  {/* “summary” equivalent */}
  <p class="postlist-description">
    {post.data.summary ??
      prepareOgText(post.body ?? "", { maxLength: 180 })}
  </p>
  <ArchivePostListMetadata
    postSource={post.data.source}
    postTags={post.data.tags}
    postSlug={post.id}
    postDate={post.data.date}
    postReadingTime={postReadingTime}
  />
</li>

<style>
.archive-source-badge {
  display: inline-block;
  font-size: 0.75rem;
  padding: 0.1rem 0.4rem;
  margin-inline-end: 0.5rem;
}

.source-wordpress, .source-microblog { background-color: var(--background-color-overlay); }
</style>
