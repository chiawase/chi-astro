---
import FormattedDate from "@components/FormattedDate.astro";
import WebmentionsSummary from "@components/WebmentionsSummary.astro";

interface Props {
  postTags: string[] | undefined;
  postSlug: string;
  postDate: Date;
  postLanguage?: string;
  postReadingTime?: string;
  wmSummary?: {
    likes: number;
    reposts: number;
    replies: number;
    mentionOfs: number;
  }
}

const {
  postTags,
  postSlug,
  postDate,
  postLanguage,
  postReadingTime,
  wmSummary
} = Astro.props;

const likesSize = wmSummary?.likes ?? 0;
const repostsSize = wmSummary?.reposts?? 0;
const repliesSize = wmSummary?.replies ?? 0;
const mentionsOfSize = wmSummary?.mentionOfs ?? 0;

const hasAnyWebmentions = (likesSize + repostsSize + repliesSize + mentionsOfSize > 0);
---

<ul class="post-metadata">
  <li>
    <a href=`/blog/${postSlug}/` class="postlist-link">
    <FormattedDate
      dateType="published"
      dateString={postDate}
    /></a>
    <span class="post-metadata-separator"></span>
  </li>
  {hasAnyWebmentions && (
  <li>
    <WebmentionsSummary
      likes={likesSize}
      reposts={repostsSize}
      replies={repliesSize}
      mentionOfs={mentionsOfSize}
    />
    <span class="post-metadata-separator"></span>
  </li>
  )}
  <li>
    <span class="post-reading-time">{postReadingTime}</span>
    <span class="post-metadata-separator"></span>
  </li>
  <li>
    {Array.isArray(postTags) && postTags.length > 0 && (
      <div class="postlist-tags">
        {postTags.map((t) => (
          <a href=`/tags/${t}/` class="post-tag p-category">{t}</a>
        ))}
      </div>
    )}
  </li>
  {postLanguage && (<li>
    <span class="post-metadata-separator"></span>
    <span class="label">Post language:</span> <span class="post-language">{postLanguage}</span>
  </li>)}
</ul>
