---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "@styles/global.css";
import type { ImageMetadata } from "astro";
import type { CollectionEntry } from "astro:content";
import { SITE_TITLE, SITE_DESCRIPTION, SITE_DOMAIN } from "@consts";

import RelMeAuth from "@components/RelMeAuth.astro";
import ColorSchemePreference from "@components/ColorSchemePreference.astro";

import { prepareOgText } from "@utils/prepare-og-text";

// Social media images via Cloudinary
import { getCldOgImageUrl } from "astro-cloudinary/helpers";

// Custom Fonts
import "@fontsource-variable/victor-mono/wght-italic.css";
import "@fontsource-variable/victor-mono";
import "@fontsource-variable/anybody/wdth-italic.css";

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  post?: CollectionEntry<"blog"> | CollectionEntry<"archive">;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, post, description } = Astro.props;

const normalizedTitle = typeof title === "string" && title.trim().length > 0 ? title.trim() : undefined;
const normalizedDescription =
  typeof description === "string" && description.trim().length > 0
  ? description.trim()
  : undefined;

const hasPostTitle = Boolean(post?.data.title && post.data.title.trim().length > 0);

const metadataTitleRaw =
  post?.data.title ||
  normalizedTitle ||
  (post?.body ? prepareOgText(post.body, { maxLength: 60 }) : "") ||
  SITE_TITLE;

const metadataDescriptionRaw =
  normalizedDescription ||
  post?.data.summary ||
  (post?.body ? prepareOgText(post.body, { maxLength: 180 }) : "") ||
  SITE_DESCRIPTION;

// For the browser tab
const documentTitle =
  metadataTitleRaw === SITE_TITLE ? SITE_TITLE : `${metadataTitleRaw} • ${SITE_TITLE}`;

const cldTitleRaw =
  post && !hasPostTitle
  ? "Chi’s blog post"
  : metadataTitleRaw;

const metadataTitleForCld = prepareOgText(cldTitleRaw, { urlEncode: true, });
const metadataDescriptionForCld = prepareOgText(metadataDescriptionRaw, { urlEncode: true });

// Thumbnail Image particulars
const metadataImageWidth = "1280";
const metadataImageHeight = "640";

const FOLDER = "chisenires.design/";
const SHARE_IMAGE_FILE_NAME = "thumbnail_odokru"; // points to https://res.cloudinary.com/chi-11ty/image/upload/v1745850878/chisenires.design/thumbnail_odokru.png
// If font not in the root of your Cloudinary media library, need to prepend with `foldername:`

const TITLE_FONT = "open sans"; // setting to Open Sans for now
const TITLE_FONT_SIZE = 60;
const TITLE_BOTTOM_OFFSET = 378;

const TAGLINE_FONT = "open sans";
const TAGLINE_FONT_SIZE = 36;
const TAGLINE_TOP_OFFSET = 298;

const URL_FONT = "open sans";
const URL_FONT_SIZE = 36;
const URL_BOTTOM_OFFSET = 24;

const TEXT_AREA_WIDTH = 1071;
const TEXT_LEFT_OFFSET = 60;
const TEXT_COLOR = "rgb:FDFDFD";

const ogImageUrl = getCldOgImageUrl({
  src: FOLDER+SHARE_IMAGE_FILE_NAME,
  width: metadataImageWidth,
  height: metadataImageHeight,
  quality: "auto:best",
  format: "png",
  overlays: [
    {
      width: TEXT_AREA_WIDTH,
      crop: "fit",
      text: {
        fontFamily: TITLE_FONT,
        fontSize: TITLE_FONT_SIZE,
        color: TEXT_COLOR,
        fontWeight: "bold_normal",
        alignment: "left",
        text: metadataTitleForCld
      },
      position: {
        x: TEXT_LEFT_OFFSET,
        y: TITLE_BOTTOM_OFFSET,
        gravity: "south_west"
      }
    },
    {
      width: TEXT_AREA_WIDTH,
      crop: "fit",
      text: {
        fontFamily: TAGLINE_FONT,
        fontSize: TAGLINE_FONT_SIZE,
        color: TEXT_COLOR,
        fontWeight: "normal",
        alignment: "left",
        text: metadataDescriptionForCld
      },
      position: {
        x: TEXT_LEFT_OFFSET,
        y: TAGLINE_TOP_OFFSET,
        gravity: "north_west"
      }
    },
    {
      width: TEXT_AREA_WIDTH,
      crop: "fit",
      text: {
        fontFamily: URL_FONT,
        fontSize: URL_FONT_SIZE,
        color: TEXT_COLOR,
        fontWeight: "bold_normal",
        alignment: "left",
        text: SITE_DOMAIN
      },
      position: {
        x: TEXT_LEFT_OFFSET,
        y: URL_BOTTOM_OFFSET,
        gravity: "south_west"
      }
    }
  ],
});
---

<ColorSchemePreference />

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/favicon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/atom+xml"
  title={SITE_TITLE}
  href={new URL("feed.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{documentTitle}</title>

<meta name="title" content={metadataTitleRaw} />
<meta name="description" content={metadataDescriptionRaw} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={metadataTitleRaw} />
<meta property="og:description" content={metadataDescriptionRaw} />
<meta property="og:site_name" content={SITE_DOMAIN} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1280" />
<meta property="og:image:height" content="640" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={metadataTitleRaw} />
<meta property="twitter:description" content={metadataDescriptionRaw} />
<meta property="twitter:domain" content={SITE_DOMAIN} />
<meta property="twitter:image" content={ogImageUrl} />

<!-- For Fediverse tag -->
<meta name="fediverse:creator" content="@chi@social.lol" />

<!-- rel-me link tags -->
<RelMeAuth />

<!-- Webmentions -->
<link rel="webmention" href=`https://webmention.io/${SITE_DOMAIN}/webmention` />
<link rel="pingback" href=`https://webmention.io/${SITE_DOMAIN}/xmlrpc` />

<!-- Restricting indexing with AI crawlers
From: https://simplycreative.uk/stop-chatgpt-ai-scraping/ -->
<meta name="robots" content="noai, noimageai" />
<meta name="ChatGPTBot" content="noindex, nofollow" />

<!-- Umami tracking code -->
<script
  is:inline
  defer
  src="https://umami.chisenires.design/script.js"
  data-website-id="82d4b6de-5ddb-4afb-bb8e-515e93b89f91"
  data-do-not-track="true"></script>
