---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

import { DateTime } from "luxon";

import GameMetadata from "@components/GameMetadata.astro";

interface Props {
  game: CollectionEntry<"games">;
}

const { game } = Astro.props;

const startedPlaying = DateTime.fromJSDate(game.data.startedPlayingDate, { zone: "UTC+8" }).toFormat("dd MMM yyyy");
const lastPlayed = DateTime.fromJSDate(game.data.lastPlayedDate, { zone: "UTC+8" }).toFormat("dd MMM yyyy");
---

<li class="postlist-item game-list-item">
  <div class="game-details">
    <a href={`/games/${game.id}/`} class="postlist-link postlist-header">
      {game.data.title}
    </a>
    <GameMetadata
      status={game.data.status}
      platform={game.data.platform}
      startedPlaying={startedPlaying}
      lastPlayed={lastPlayed}
      gameUrl={game.data.url}
    />
  </div>
  {game.data.gameImage &&
    (<Image src={game.data.gameImage}
      inferSize={true}
      class="game-cover-image"
      alt=`Cover photo for ${game.data.title}`
      />
    ) /* eventually add some fallback image here */}
</li>
<style>


.game-list-item {
  display: flex;
  flex-flow: row nowrap;
  justify-content: space-between;

  & .game-details {
    display: block;
  }

  & .game-cover-image {
    --cover-size: 15rem;

    width: var(--cover-size);
    height: var(--cover-size);
    object-fit: cover;
  }
}
</style>
