---
import type { CollectionEntry } from "astro:content";
import PostListMetadata from "@components/PostListMetadata.astro";
import { prepareOgText } from "@utils/prepareOgText";

import { getReadingTime } from "@utils/readingTime";

interface Props {
  post: CollectionEntry<"blog"> | CollectionEntry<"archive">;
  wmSummary?: {
    likes: number;
    reposts: number;
    replies: number;
    mentionOfs: number;
  }
}

const { post, wmSummary } = Astro.props;

// Calculate reading time using `body` property
const postReadingTime = getReadingTime(post.body ?? "");

const hasSource = "source" in post.data && post.data.source;
const postUrl = hasSource
  ? `/archive/${post.data.source}/${post.id}/`
  : `/blog/${post.id}/`;
const postDate = "pubDate" in post.data ? post.data.pubDate : post.data.date;
const postLanguage = "postLanguage" in post.data
  ? post.data.postLanguage ?? undefined
  : undefined;
---

<li class="postlist-item">
  {/* if with title */}
  {post.data.title && (
    <a href={postUrl} class="postlist-link postlist-header">
      {post.data.title}
    </a>
  )}

  {/* “summary” equivalent */}
  <p class="postlist-description">
    {post.data.summary ??
      prepareOgText(post.body ?? "", { maxLength: 180 })}
  </p>
  <PostListMetadata
    postTags={post.data.tags}
    postUrl={postUrl}
    postDate={postDate}
    postLanguage={postLanguage}
    postReadingTime={postReadingTime}
    wmSummary={wmSummary}
  />
</li>
