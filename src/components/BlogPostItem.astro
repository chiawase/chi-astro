---
import type { CollectionEntry } from "astro:content";
import PostListMetadata from "@components/PostListMetadata.astro";
import { prepareOgText } from "@utils/prepareOgText";

import { getReadingTime } from "@utils/readingTime";

interface Props {
  post: CollectionEntry<"blog">;
  wmSummary?: {
    likes: number;
    reposts: number;
    replies: number;
    mentionOfs: number;
  }
}

const { post, wmSummary } = Astro.props;

// Calculate reading time using `body` property
const postReadingTime = getReadingTime(post.body ?? "");
---

<li class="postlist-item">
  {/* if with title */}
  {post.data.title && (
      <a href={`/blog/${post.id}/`} class="postlist-link postlist-header">
        {post.data.title}
      </a>
    )}

  {/* “summary” equivalent */}
  <p class="postlist-description">
    {post.data.summary ??
      prepareOgText(post.body ?? "", { maxLength: 180 })}
  </p>
  <PostListMetadata
    postTags={post.data.tags}
    postSlug={post.id}
    postDate={post.data.pubDate}
    postLanguage={post.data.postLanguage ?? undefined}
    postReadingTime={postReadingTime}
    wmSummary={wmSummary}
  />
</li>
