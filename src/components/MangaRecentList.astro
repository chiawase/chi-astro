---
type MangaItem = {
  id: string;
  title: string;
  url?: string;
  latestChapter?: string;
  section?: string;
};

interface Props {
  items: MangaItem[];
}

const {
  items,
} = Astro.props;

if (!items.length) return `<p><em>None yet.</em></p>`;
---

<ul>
  {items.map((manga) => (
    <li>
      {manga.section ? (
        <details>
          <summary class="now-summary">
            <a href={`/manga/${manga.id}/`}>{manga.title}</a>
            {manga.url && manga.latestChapter && (
              <>
                {" "}
                (read{" "}
                <a target="_blank" rel="noreferrer noopener" href={manga.url}>{manga.latestChapter}</a>)
              </>
            )}
          </summary>
          <div set:html={manga.section} />
        </details>
      ) : (
        <>
          <a href={`/manga/${manga.id}/`}>{manga.title}</a>
          {manga.url && manga.latestChapter && (
            <>
              {" "}
              (read{" "}
              <a target="_blank" rel="noreferrer noopener" href={manga.url}>{manga.latestChapter}</a>)
            </>
          )}
        </>
      )}
    </li>
  ))}
</ul>
