---
import FormattedDate from "../components/FormattedDate.astro";

interface Props {
  postTags: string[] | undefined;
  postSlug: string;
  postDate: Date;
  postUpdatedDate: Date;
  postLanguage?: string;
  postReadingTime?: string;
}

const {
  postTags,
  postSlug,
  postDate,
  postUpdatedDate,
  postLanguage,
  postReadingTime
} = Astro.props;
---
<ul class="post-metadata">
  <li>
    <span class="label">Created:</span><FormattedDate
      dateType="published"
      dateString={postDate}
    />
    <span class="post-metadata-separator"></span>
  </li>
  <li>
    <span class="label">Last updated:</span><FormattedDate
      dateType="updated"
      dateString={postUpdatedDate}
    />
    <span class="post-metadata-separator"></span>
  </li>
  <li>
    <span class="post-reading-time">{postReadingTime}</span>
    <span class="post-metadata-separator"></span>
  </li>
  <li>
    <span class="label">Tags: </span>
    {Array.isArray(postTags) && postTags.length > 0 && (
      <div class="postlist-tags">
        {postTags.map((t) => (
          <a href=`/tags/${t}/` class="post-tag p-category">{t}</a>
        ))}
      </div>
    )}
  </li>
  {postLanguage && (<li>
    <span class="post-metadata-separator"></span>
    <span class="label">Post language:</span> <span class="post-language">{postLanguage}</span>
  </li>)}
  <li>
    <span class="post-metadata-separator"></span>
    <a href={`/blog/${postSlug}/`} class="u-url post-permalink">Permalink</a>
  </li>
</ul>
<style>
/* Tags list */
.post-metadata {
  font-size: 0.8rem;
  display: inline-flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
  list-style: none;
  padding: 0;
}

.post-metadata .webmentions__summary {
  display: inline-flex;
  gap: 0.5rem;
  padding-bottom: initial;
  padding-right: 0.5rem;
}

.h-entry .post-metadata {
  margin: 1rem 0;
}

.post-metadata .label {
  color: var(--color-gray-20);
  margin-right: 0.5rem;
}

.post-metadata li .post-tag,
.post-metadata li .post-language {
  display: inline-block;
  padding: 0.015rem 0.25rem;
  background-color: var(--background-color-overlay);
}
</style>
