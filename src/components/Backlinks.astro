---
import { buildBacklinkMap } from "@utils/backlinks";

interface Props {
  currentPostId: string;
}

const { currentPostId } = Astro.props;

const backlinkMap = await buildBacklinkMap();
const links = backlinkMap[currentPostId] ?? [];
---

 {
   links.length > 0 && (
     <div class="backlinks">
       <h2>Backlinks</h2>
       <ul>
         {links.map((link) => (
           <li>
             <a href={link.url}>{link.title ?? link.id}</a>
           </li>
         ))}
       </ul>
     </div>
   )
 }

<style>
  .backlinks {
    padding-top: 1rem;

    ul {
      padding: 0;
      list-style: none;
    }
    a {
      --pad-inline: 0.5rem;
      display: block;
      border-radius: 0.25rem;
      padding-block: 0.25rem;
      padding-inline: var(--pad-inline);
      line-height: 120%;
    }
  }
</style>
