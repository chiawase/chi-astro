---
import FormattedDate from "@components/FormattedDate.astro";

interface Props {
  postTags: string[] | undefined;
  postSlug: string;
  postDate: Date;
  postReadingTime?: string;
}

const {
  postTags,
  postSlug,
  postDate,
  postReadingTime
} = Astro.props;

const hasTags = Array.isArray(postTags) && postTags.length > 0;
---
<ul class="post-metadata">
  <li>
    <span class="label">Posted:</span> <FormattedDate
      dateType="published"
      dateString={postDate}
    />
    <span class="post-metadata-separator"></span>
  </li>
  <li>
    <span class="post-reading-time">{postReadingTime}</span>
    {hasTags && (<span class="post-metadata-separator"></span>)}
  </li>
  {hasTags && (<li>
    <span class="label">Tags: </span>
    {Array.isArray(postTags) && postTags.length > 0 && (
      <div class="postlist-tags">
        {postTags.map((tag) => (
          <a href={`/tags/${tag}/`} class="post-tag p-category">{tag}</a>
        ))}
      </div>
    )}
  </li>)}
  <li>
    <span class="post-metadata-separator"></span>
    <a href={`/archive/${postSlug}/`} class="u-url post-permalink">Permalink</a>
  </li>
</ul>
