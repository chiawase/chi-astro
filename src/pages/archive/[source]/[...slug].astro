---
import { type CollectionEntry, getCollection, render } from "astro:content";
import ArchivePost from "@layouts/ArchivePost.astro";
import { getReadingTime } from "@utils/readingTime";

export async function getStaticPaths() {
  const posts = await getCollection("archive");
  posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts
    .filter((p) => Boolean(p.data.source))
    .map((post) => ({
      params: { source: post.data.source, slug: post.id },
      props: { post },
    }));
}

type Props = {
  post: CollectionEntry<"archive">;
};

const { post } = Astro.props;
const { Content } = await render(post);

const postReadingTime = getReadingTime(post.body ?? "");
---

<ArchivePost post={post} slug={post.id} postReadingTime={postReadingTime}>
  <Content />
</ArchivePost>
